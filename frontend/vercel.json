{
  "headers": [
    {
      "source": "/posts-bpen-7f3d9c",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/share/:publicId/",
      "destination": "/share/:publicId",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "^/team/(ATH|ATL|AZ|BAL|BOS|CHC|CIN|CLE|COL|CWS|DET|HOU|KC|LAA|LAD|MIA|MIL|MIN|NYM|NYY|PHI|PIT|SD|SEA|SF|STL|TB|TEX|TOR|WSH)$",
      "dest": "/team/$1/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/share/([A-Za-z0-9._-]{1,64})$",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "^/team/(.*)$",
      "dest": "/team/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
